# OpenRouter (preferred when OPENROUTER_API_KEY is set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional direct Anthropic configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Local HTTP development. Set true for HTTPS deployments.
COOKIE_SECURE=false
# Optional location for the per-account SQLite database.
ACCOUNT_DB_PATH=data/accounts.sqlite3
# Required before connecting Paytm accounts. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value private and stable; losing it makes saved merchant credentials unrecoverable.
PAYTM_CREDENTIALS_KEY=
